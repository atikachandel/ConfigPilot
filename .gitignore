__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
*.pyo
*.pyd
*.sqlite3
*.db

# Local virtual environments and tool caches
.venv/
venv/
env/
.env
.env.*
*.env

# Credential / secret style files
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.secret
*.token
*.bak

# Runtime-generated artifacts — these are created by the API/Ansible at
# runtime and shouldn't be committed. .gitkeep files preserve the folders.
generated_configs/*
!generated_configs/.gitkeep
mock_devices/dev/*
mock_devices/staging/*
mock_devices/prod/*
!mock_devices/**/.gitkeep

.vscode/
.idea/

.DS_Store
*.log
